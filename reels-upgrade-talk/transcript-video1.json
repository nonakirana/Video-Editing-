[
 {
  "start": 0.43,
  "end": 1.43,
  "text": "Terima kasih."
 },
 {
  "start": 10.43,
  "end": 17.34,
  "text": "Isu perumahan bercakap tentang abderi ataupun naik tarab bersama Lona Kirana."
 },
 {
  "start": 17.34,
  "end": 20.34,
  "text": "Baiklah, teruskan perbicara kita."
 },
 {
  "start": 20.34,
  "end": 25.34,
  "text": "Lona, kenapa masyarakat kita ini rata-rata takut nak abderi ataupun nak naik tarab?"
 },
 {
  "start": 26.34,
  "end": 32.34,
  "text": "Memang orang Melayu kita ini berada, beralah, serendah diri, sopan santun."
 },
 {
  "start": 32.34,
  "end": 35.34,
  "text": "Jadi pada mereka ini, bila kita cakap tentang naik tarab atau upgrade,"
 },
 {
  "start": 35.34,
  "end": 36.34,
  "text": "macam menunjuk."
 },
 {
  "start": 36.34,
  "end": 37.34,
  "text": "Show off."
 },
 {
  "start": 37.34,
  "end": 40.34,
  "text": "Itulah dia nak lebih daripada orang lain kan."
 },
 {
  "start": 40.34,
  "end": 43.34,
  "text": "Dan dia takut periuk-periuk besar keraknya."
 },
 {
  "start": 43.34,
  "end": 47.34,
  "text": "Tapi saya rasa apabila kita fikir tentang keperluan kita di hari tua nanti,"
 },
 {
  "start": 47.34,
  "end": 51.34,
  "text": "perancangan perumahan pada hari ini memainkan peranan yang besar."
 },
 {
  "start": 51.34,
  "end": 53.34,
  "text": "Kerana Lona juga ada satu kes di mana,"
 },
 {
  "start": 53.34,
  "end": 54.34,
  "text": "Kakak ini comelah."
 },
 {
  "start": 54.34,
  "end": 56.34,
  "text": "Dia kata, saya selalu tengok Lona di Facebook buat live."
 },
 {
  "start": 56.34,
  "end": 58.34,
  "text": "Jadi macam tegeraklah, Kakak nak downgrade."
 },
 {
  "start": 58.34,
  "end": 60.34,
  "text": "Umur Kakak berapa? 48."
 },
 {
  "start": 60.34,
  "end": 62.34,
  "text": "Oh Kakak nak downgrade rumah berapa bilik?"
 },
 {
  "start": 62.34,
  "end": 65.34,
  "text": "Oh pindah rumah 4 bilik je, daripada 5 bilik ke 4 bilik."
 },
 {
  "start": 65.34,
  "end": 67.34,
  "text": "Bila Lona tengok,"
 },
 {
  "start": 68.34,
  "end": 72.34,
  "text": "income pendapatan keluarganya, suaminya bergaji besar."
 },
 {
  "start": 72.34,
  "end": 75.34,
  "text": "Dan dia mampu sebenarnya untuk pindah ke rumah private."
 },
 {
  "start": 75.34,
  "end": 78.34,
  "text": "Jadi dia kata tak terfikir Kakak telefon kau nak downgrade"
 },
 {
  "start": 78.34,
  "end": 80.34,
  "text": "yang kau suruh aku upgrade itu apa hal."
 },
 {
  "start": 80.34,
  "end": 81.34,
  "text": "Betul."
 },
 {
  "start": 81.34,
  "end": 86.34,
  "text": "Jadi bila Lona buat kira-kira dan Abang tu memang boleh bayar habis rumah kondo"
 },
 {
  "start": 86.34,
  "end": 90.34,
  "text": "bila umur dia 65 tahun, dia rasa macam tenang."
 },
 {
  "start": 90.34,
  "end": 93.34,
  "text": "Bayangkan pada ketika itu rumah 5 bilik di Jurung West"
 },
 {
  "start": 93.34,
  "end": 96.34,
  "text": "rata-rata harganya dalam Rp650,000."
 },
 {
  "start": 96.34,
  "end": 98.34,
  "text": "Kalau Lona pindah ke rumah 4 bilik,"
 },
 {
  "start": 98.34,
  "end": 100.34,
  "text": "500,000 memang boleh bayar habis tak ada masalah."
 },
 {
  "start": 100.34,
  "end": 104.34,
  "text": "Tapi disebabkan saya konon bantu mereka"
 },
 {
  "start": 104.34,
  "end": 109.34,
  "text": "untuk fikir, upgradelah untuk perancangan masa depan lebih baik."
 },
 {
  "start": 109.34,
  "end": 112.34,
  "text": "Jadi Lona belikan mereka kondo di kawasan Jurung West juga"
 },
 {
  "start": 112.34,
  "end": 114.34,
  "text": "pada 1.1 juta dolar."
 },
 {
  "start": 114.34,
  "end": 118.34,
  "text": "Bulan-bulan Abang bayar gunakan CPF tak perlu top up sebarang cash"
 },
 {
  "start": 118.34,
  "end": 120.34,
  "text": "kerana duit CPF Abang cukup."
 },
 {
  "start": 120.34,
  "end": 125.34,
  "text": "6 tahun kemudian kondonya sekarang nilainya 1.6 juta dolar."
 },
 {
  "start": 125.34,
  "end": 128.34,
  "text": "500 dolar daripada 1.1 juta."
 },
 {
  "start": 128.34,
  "end": 132.34,
  "text": "Jadi dalam masa 5 tahun dia naik 500,000 dolar."
 },
 {
  "start": 132.34,
  "end": 134.34,
  "text": "Bayangkan kalau Lona dengar cakap dia,"
 },
 {
  "start": 134.34,
  "end": 136.34,
  "text": "Lona kata tak apalah Kakak downgrade duduk diam-diam."
 },
 {
  "start": 136.34,
  "end": 139.34,
  "text": "Dia rugi potensi yang dia boleh dapat."
 },
 {
  "start": 139.34,
  "end": 140.34,
  "text": "Jadi Kakak pun sekarang happy,"
 },
 {
  "start": 140.34,
  "end": 142.34,
  "text": "hari-hari boleh pandang siming pool."
 },
 {
  "start": 142.34,
  "end": 144.34,
  "text": "Jem."
 },
 {
  "start": 144.34,
  "end": 146.34,
  "text": "Jem dia singgah saja."
 },
 {
  "start": 146.34,
  "end": 148.34,
  "text": "Orang tu beli kondo tapi jem dia singgah saja."
 },
 {
  "start": 148.34,
  "end": 152.34,
  "text": "Tapi apa yang saya rasa happy sangat kerana"
 },
 {
  "start": 152.34,
  "end": 154.34,
  "text": "bila Kakak tu kata pandongan baru-baru ni"
 },
 {
  "start": 154.34,
  "end": 156.34,
  "text": "kalau Kakak patah balik,"
 },
 {
  "start": 156.34,
  "end": 159.34,
  "text": "kurangnya Kakak ada 500,000 lebih cash"
 },
 {
  "start": 159.34,
  "end": 162.34,
  "text": "disebabkan oleh kapital appreciation kondo tersebut."
 },
 {
  "start": 162.34,
  "end": 164.34,
  "text": "Dan bercakap tentang kondo juga."
 },
 {
  "start": 164.34,
  "end": 166.34,
  "text": "Kondo apa nak beli bolehkah tidak?"
 },
 {
  "start": 166.34,
  "end": 168.34,
  "text": "Promnex saya rasa ada tools."
 },
 {
  "start": 168.34,
  "end": 170.34,
  "text": "Promnex tech tools"
 },
 {
  "start": 170.34,
  "end": 172.34,
  "text": "yang boleh bantu kita buat forecasting"
 },
 {
  "start": 172.34,
  "end": 174.34,
  "text": "bila kita beli projek ni,"
 },
 {
  "start": 174.34,
  "end": 176.34,
  "text": "berapakah kapital appreciation."
 },
 {
  "start": 176.34,
  "end": 178.34,
  "text": "Projek ni bagus untuk kita beli ke tidak."
 },
 {
  "start": 178.34,
  "end": 180.34,
  "text": "Bila nak jual dalam masa 10 tahun ok ke tidak."
 },
 {
  "start": 180.34,
  "end": 182.34,
  "text": "Jadi mereka ada informasi dan data"
 },
 {
  "start": 182.34,
  "end": 184.34,
  "text": "untuk bantu saya dan para pelanggan saya"
 },
 {
  "start": 184.34,
  "end": 186.34,
  "text": "buat keputusan yang lebih baik lagi."
 },
 {
  "start": 186.34,
  "end": 188.34,
  "text": "Jadi tak semua naik taraf tu tak baik."
 },
 {
  "start": 188.34,
  "end": 192.34,
  "text": "Memanglah dari segi size tak boleh lawan dengan HDB."
 },
 {
  "start": 192.34,
  "end": 194.34,
  "text": "Tapi dari segi asset class,"
 },
 {
  "start": 194.34,
  "end": 196.34,
  "text": "anda pindah ke sesuatu"
 },
 {
  "start": 196.34,
  "end": 198.34,
  "text": "perumahan yang lebih tinggi daripada perumahan awam."
 },
 {
  "start": 198.34,
  "end": 200.34,
  "text": "Tapi bila anda patah balik,"
 },
 {
  "start": 200.34,
  "end": 202.34,
  "text": "sekarang kan dah tak ada cooling period bermaksud"
 },
 {
  "start": 202.34,
  "end": 204.34,
  "text": "kalau Kakak-kak kita yang sekarang tengah kondo,"
 },
 {
  "start": 204.34,
  "end": 206.34,
  "text": "ada puas tengah kondo, dah tak pakai lagi swimming pool itu."
 },
 {
  "start": 206.34,
  "end": 208.34,
  "text": "Boleh patah balik ke HDB"
 },
 {
  "start": 208.34,
  "end": 211.34,
  "text": "tanpa nak tumpang-tumpang rumah orang."
 },
 {
  "start": 211.34,
  "end": 214.34,
  "text": "Kerana dulu ada 15 bulan cooling period."
 },
 {
  "start": 214.34,
  "end": 216.34,
  "text": "Selepas penjualan kondo rumah private anda"
 },
 {
  "start": 216.34,
  "end": 219.34,
  "text": "perlu rehat 15 bulan sebelum anda masuk ke"
 },
 {
  "start": 219.34,
  "end": 221.34,
  "text": "perumahan awam HDB."
 },
 {
  "start": 221.34,
  "end": 222.34,
  "text": "Sekarang tak perlu."
 },
 {
  "start": 222.34,
  "end": 224.34,
  "text": "Jual kondo, jual landed,"
 },
 {
  "start": 224.34,
  "end": 226.34,
  "text": "terus anda boleh pindah ke HDB"
 },
 {
  "start": 226.34,
  "end": 228.34,
  "text": "dengan selepuk cash dalam bank"
 },
 {
  "start": 228.34,
  "end": 230.34,
  "text": "hasil daripada penjualan rumah private anda."
 },
 {
  "start": 230.34,
  "end": 232.34,
  "text": "Jadi ini yang anda rasa kalau kita mampu,"
 },
 {
  "start": 232.34,
  "end": 233.34,
  "text": "kita boleh."
 },
 {
  "start": 233.34,
  "end": 234.34,
  "text": "Anda buat perkiraan,"
 },
 {
  "start": 234.34,
  "end": 236.34,
  "text": "tengok hutang bank kelayakan anda"
 },
 {
  "start": 236.34,
  "end": 239.34,
  "text": "dan pastikan anda boleh duduk"
 },
 {
  "start": 239.34,
  "end": 241.34,
  "text": "sekurang kurangnya 7 hingga 10 tahun."
 },
 {
  "start": 241.34,
  "end": 242.34,
  "text": "Jangan dengar cakap orang,"
 },
 {
  "start": 242.34,
  "end": 243.34,
  "text": "beli kondo 2 tahun,"
 },
 {
  "start": 243.34,
  "end": 244.34,
  "text": "CPF dah habis,"
 },
 {
  "start": 244.34,
  "end": 246.34,
  "text": "kena top up cash pening kepala."
 },
 {
  "start": 246.34,
  "end": 249.34,
  "text": "Mesti ada apa yang saya panggil sustainability."
 },
 {
  "start": 249.34,
  "end": 252.34,
  "text": "Kalau anda rasa anda mampu untuk bertahan di kondo itu"
 },
 {
  "start": 252.34,
  "end": 253.34,
  "text": "7 hingga 10 tahun,"
 },
 {
  "start": 253.34,
  "end": 254.34,
  "text": "anda rasa ia melupakan"
 },
 {
  "start": 254.34,
  "end": 255.34,
  "text": "satu pelaburan yang baik."
 },
 {
  "start": 267.86,
  "end": 268.86,
  "text": "Betul. Sebab itu,"
 },
 {
  "start": 268.86,
  "end": 270.86,
  "text": "anda sebenarnya bekerjalah"
 },
 {
  "start": 270.86,
  "end": 271.86,
  "text": "dengan beberapa perancangan kewangan."
 },
 {
  "start": 271.86,
  "end": 274.86,
  "text": "Dalam tim saya namanya Baraka Homes."
 },
 {
  "start": 274.86,
  "end": 276.86,
  "text": "Dan kami pastikan apabila mereka"
 },
 {
  "start": 276.86,
  "end": 277.86,
  "text": "naik taraf ke rumah private,"
 },
 {
  "start": 277.86,
  "end": 279.86,
  "text": "ada perancangan untuk memastikan"
 },
 {
  "start": 279.86,
  "end": 281.86,
  "text": "hutang rumah habis bayar"
 },
 {
  "start": 281.86,
  "end": 282.86,
  "text": "pada usia 55 tahun."
 },
 {
  "start": 282.86,
  "end": 284.86,
  "text": "Kalau tidak berlaku kematian,"
 },
 {
  "start": 284.86,
  "end": 286.86,
  "text": "penyakit-penyakit kronik"
 },
 {
  "start": 286.86,
  "end": 288.86,
  "text": "ataupun mereka jadi vegetable."
 },
 {
  "start": 288.86,
  "end": 289.86,
  "text": "Buang kerja pun."
 },
 {
  "start": 289.86,
  "end": 290.86,
  "text": "Jadi, kita akan bantu mereka"
 },
 {
  "start": 290.86,
  "end": 292.86,
  "text": "untuk pastikan ada buffer."
 },
 {
  "start": 292.86,
  "end": 294.86,
  "text": "Jadi, mereka tak perlu jual rumah"
 },
 {
  "start": 294.86,
  "end": 295.86,
  "text": "waktu terlesak."
 },
 {
  "start": 295.86,
  "end": 297.86,
  "text": "Bayangkan, anda beli rumah kondo itu 2-3 tahun,"
 },
 {
  "start": 297.86,
  "end": 298.86,
  "text": "tiba-tiba satu orang kena"
 },
 {
  "start": 298.86,
  "end": 299.86,
  "text": "penyakit kanser."
 },
 {
  "start": 301.86,
  "end": 302.86,
  "text": "Jadi, bagaimana?"
 },
 {
  "start": 302.86,
  "end": 303.86,
  "text": "Anda tahu,"
 },
 {
  "start": 303.86,
  "end": 304.86,
  "text": "satu orang dah tak boleh bayar duit rumah."
 },
 {
  "start": 304.86,
  "end": 305.86,
  "text": "Tapi, kalau kita ada"
 },
 {
  "start": 305.86,
  "end": 307.86,
  "text": "perancangan kewangan yang baik,"
 },
 {
  "start": 307.86,
  "end": 308.86,
  "text": "kita ada buffer."
 },
 {
  "start": 308.86,
  "end": 309.86,
  "text": "Buffer itu boleh bantu"
 },
 {
  "start": 309.86,
  "end": 310.86,
  "text": "untuk bayar duit rumah"
 },
 {
  "start": 310.86,
  "end": 312.86,
  "text": "sambil kita jalani rawatan."
 },
 {
  "start": 312.86,
  "end": 314.86,
  "text": "Dan bila tiba-tiba masanya yang sesuai"
 },
 {
  "start": 314.86,
  "end": 315.86,
  "text": "untuk kita jual, kita jual"
 },
 {
  "start": 315.86,
  "end": 316.86,
  "text": "dan patah balik ke rumah HDB."
 },
 {
  "start": 316.86,
  "end": 318.86,
  "text": "Jadi, perancangan ini perlu"
 },
 {
  "start": 318.86,
  "end": 319.86,
  "text": "kerana ramai yang gairah."
 },
 {
  "start": 319.86,
  "end": 320.86,
  "text": "Mereka main terjun saja,"
 },
 {
  "start": 320.86,
  "end": 321.86,
  "text": "masuk beli."
 },
 {
  "start": 321.86,
  "end": 323.86,
  "text": "Tapi, mereka tak fikir tentang"
 },
 {
  "start": 323.86,
  "end": 324.86,
  "text": "kecemasan, what ifs."
 },
 {
  "start": 324.86,
  "end": 325.86,
  "text": "Kena buang kerja,"
 },
 {
  "start": 325.86,
  "end": 327.86,
  "text": "tak nak kerja sakit dan sebagainya."
 },
 {
  "start": 335.86,
  "end": 336.86,
  "text": "Seperti yang anda katakan,"
 },
 {
  "start": 336.86,
  "end": 338.86,
  "text": "perumahan awam HDB"
 },
 {
  "start": 338.86,
  "end": 339.86,
  "text": "dan perumahan private"
 },
 {
  "start": 339.86,
  "end": 341.86,
  "text": "2 pasaran hartaanah yang berbeza."
 },
 {
  "start": 341.86,
  "end": 343.86,
  "text": "Dan, kalau kita tengok pasaran"
 },
 {
  "start": 343.86,
  "end": 344.86,
  "text": "hartaanah Singapura,"
 },
 {
  "start": 344.86,
  "end": 345.86,
  "text": "memang private property ini,"
 },
 {
  "start": 345.86,
  "end": 348.86,
  "text": "capital appreciation-nya lebih sedikit."
 },
 {
  "start": 348.86,
  "end": 350.86,
  "text": "Jadi, kalau mereka yang mampu,"
 },
 {
  "start": 350.86,
  "end": 351.86,
  "text": "ada keberanian,"
 },
 {
  "start": 351.86,
  "end": 353.86,
  "text": "saya rasa penting untuk anda"
 },
 {
  "start": 353.86,
  "end": 355.86,
  "text": "fikirkan untuk pelaburan"
 },
 {
  "start": 355.86,
  "end": 356.86,
  "text": "masa hadapan."
 },
 {
  "start": 356.86,
  "end": 358.86,
  "text": "Jadi, bila anda bersara nanti,"
 },
 {
  "start": 358.86,
  "end": 359.86,
  "text": "anda akan bersara dengan lebih selesa."
 },
 {
  "start": 359.86,
  "end": 361.86,
  "text": "Saya ada kes dua pakcik ini."
 },
 {
  "start": 361.86,
  "end": 363.86,
  "text": "Satu pakcik 77 tahun,"
 },
 {
  "start": 363.86,
  "end": 365.86,
  "text": "tinggal di rumah 4 bilik di Mas Ling."
 },
 {
  "start": 365.86,
  "end": 366.86,
  "text": "Dari hari pertama,"
 },
 {
  "start": 366.86,
  "end": 367.86,
  "text": "katanya dia beli rumah itu"
 },
 {
  "start": 367.86,
  "end": 368.86,
  "text": "38 ribu sahaja."
 },
 {
  "start": 368.86,
  "end": 369.86,
  "text": "Mana dah dapat 4 bilik,"
 },
 {
  "start": 369.86,
  "end": 370.86,
  "text": "38 ribu."
 },
 {
  "start": 370.86,
  "end": 372.86,
  "text": "Tapi, bila tiba masanya dia nak jual,"
 },
 {
  "start": 372.86,
  "end": 374.86,
  "text": "nak pindah rumah 3 bilik dekat dengan anak,"
 },
 {
  "start": 374.86,
  "end": 376.86,
  "text": "keuntungan cash dia 30 ribu sahaja."
 },
 {
  "start": 376.86,
  "end": 377.86,
  "text": "Jadi, pakcik kata,"
 },
 {
  "start": 377.86,
  "end": 378.86,
  "text": "eh susah payah job di rumah"
 },
 {
  "start": 378.86,
  "end": 380.86,
  "text": "30 ribu cash sahaja."
 },
 {
  "start": 380.86,
  "end": 381.86,
  "text": "Kerana apa?"
 },
 {
  "start": 381.86,
  "end": 384.86,
  "text": "Semakin rumah itu berusia,"
 },
 {
  "start": 384.86,
  "end": 386.86,
  "text": "rate of growth dia kurang sedikit."
 },
 {
  "start": 386.86,
  "end": 387.86,
  "text": "Bermaksud, keuntungan yang dia boleh raih"
 },
 {
  "start": 387.86,
  "end": 388.86,
  "text": "daripada rumah tersebut,"
 },
 {
  "start": 388.86,
  "end": 390.86,
  "text": "tidak sebanyak."
 },
 {
  "start": 390.86,
  "end": 392.86,
  "text": "Kalau dia tinggal di rumah yang lebih muda."
 },
 {
  "start": 392.86,
  "end": 394.86,
  "text": "Dia berbanding dengan seorang lagi pakcik."
 },
 {
  "start": 394.86,
  "end": 395.86,
  "text": "Nuna jumpa dia,"
 },
 {
